#the mod name as displayed in-game
displayName: "Logic Assistant"

#the internal name of your mod
name: "logic-assistant"

#your name
author: "nazik360"

#the fully qualified main class of the mod
main: "ai.logicassistant.LogicAssistantMod"

#the mod description as seen in the mod dialog
description: "AI assistant for generating Mindustry Logic mlog code."

#the mod version
version: "0.5.0"

#the minimum game build required to run this mod
minGameVersion: 159.7

#this is a java mod
java: true
